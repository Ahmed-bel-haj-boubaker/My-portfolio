# Gmail account that sends the contact-form emails
GMAIL_USER=you@gmail.com
# 16-character Google App Password: Google Account > Security > 2-Step Verification > App passwords
GMAIL_APP_PASSWORD=
# Where new messages are delivered (defaults to GMAIL_USER)
CONTACT_TO=

# Optional: Search Console / Bing Webmaster ownership tokens (meta-tag method)
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
